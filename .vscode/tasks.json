{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "ProLight: install",
      "type": "shell",
      "command": "npm install",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "ProLight: dev",
      "type": "shell",
      "command": "npm run dev",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "custom",
        "pattern": {
          "regexp": "^(.*)$",
          "message": 1
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "vite",
          "endsPattern": "ready in"
        }
      }
    },
    {
      "label": "ProLight: lint",
      "type": "shell",
      "command": "npm run lint",
      "group": "test"
    },
    {
      "label": "ProLight: build",
      "type": "shell",
      "command": "npm run build",
      "group": "build"
    }
  ]
}
